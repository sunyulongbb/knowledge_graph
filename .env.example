# Replace with a unique, long password before starting the Enterprise stack.
ARANGO_ROOT_PASSWORD=replace-this-with-a-long-random-password

# Local Bun server connects to the database ports exposed by Docker.
KNOWLEDGE_STORAGE_BACKEND=arangodb
ARANGO_URL=http://127.0.0.1:8529
ARANGO_USERNAME=root
ARANGO_PASSWORD=${ARANGO_ROOT_PASSWORD}
ELASTICSEARCH_URL=http://localhost:9200

# Legacy SQLite -> ArangoDB/ES mirroring. Keep disabled once ArangoDB owns knowledge.
# Enabling this rebuilds graph data from SQLite, including snapshot cleanup.
KNOWLEDGE_LEGACY_SQLITE_SYNC=false

# arangodb: Enterprise primary knowledge; sqlite: Lite offline knowledge.
# If omitted, ARANGO_URL selects arangodb, otherwise sqlite.
# Set KNOWLEDGE_STORAGE_BACKEND=sqlite explicitly for Lite offline mode.

# Direct entity -> Elasticsearch reconciliation interval (milliseconds).
ENTITY_ES_SYNC_INTERVAL_MS=30000
